{
  "name": "minipascal",
  "version": "5.5.0",
  "private": true,
  "description": "Analisador MiniPascal com núcleo SLR(1) em Java e interface Electron",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run java:compile && node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/update-manager.cjs && node --check src/ui-utils.js && node --check src/tree-graph.js && node --check src/renderer.js && node --check src/java-runner.cjs && node --check scripts/build-java.cjs",
    "dist:win": "npm run java:runtime && npm run icon:win && electron-builder --win nsis portable",
    "icon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icon.ps1",
    "java:compile": "node scripts/build-java.cjs",
    "java:runtime": "node scripts/build-java.cjs --runtime"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.minipascal.studio",
    "productName": "MiniPascal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "tests/*.txt",
      "package.json",
      "README.md",
      "assets/minipascal.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MiniPascal-${version}-${arch}.${ext}",
      "icon": "assets/minipascal.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuuizV",
        "repo": "MiniPascalParser-Didatico",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MiniPascal-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MiniPascal-Portable-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "java/build/minipascal-engine.jar",
        "to": "engine/minipascal-engine.jar"
      },
      {
        "from": "java/build/runtime",
        "to": "engine/runtime"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
