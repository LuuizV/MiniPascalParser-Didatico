{
  "name": "minipascal-studio",
  "version": "5.0.0",
  "private": true,
  "description": "Ambiente visual de análise léxica e sintática SLR(1) em Electron, sem Java/Python em runtime",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core.cjs && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.minipascal.studio",
    "productName": "MiniPascal Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "tests/*.txt",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
