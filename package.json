{
  "name": "minipascal-studio",
  "version": "5.1.2",
  "private": true,
  "description": "Bancada didática de compiladores: Lexer, Parser e simulador SLR(1), com atualização pelas Releases do GitHub",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/update-manager.cjs && node --check src/core.cjs && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "br.com.minipascal.studio",
    "productName": "MiniPascal Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "tests/*.txt",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MiniPascal-Studio-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuuizV",
        "repo": "MiniPascalParser-Didatico",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MiniPascal-Studio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MiniPascal-Studio-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
